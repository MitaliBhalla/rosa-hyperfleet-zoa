FROM registry.access.redhat.com/ubi9/go-toolset:1.26.5-1785791459 AS builder
USER root

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG ZOA_VERSION=0.2.0

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

RUN GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown") && \
    BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ) && \
    VERSION_PKG="github.com/openshift-online/rosa-hyperfleet-zoa/internal/version" && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -buildvcs=false \
    -ldflags="-w -s -X ${VERSION_PKG}.Version=${ZOA_VERSION} -X ${VERSION_PKG}.GitCommit=${GIT_COMMIT} -X ${VERSION_PKG}.BuildDate=${BUILD_DATE}" \
    -o /app/zoa ./cmd/zoa/ && \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -buildvcs=false \
    -ldflags="-w -s -X ${VERSION_PKG}.Version=${ZOA_VERSION} -X ${VERSION_PKG}.GitCommit=${GIT_COMMIT} -X ${VERSION_PKG}.BuildDate=${BUILD_DATE}" \
    -o /app/zoa-runner ./cmd/zoa-runner/

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8-1785339117

ARG VERSION=0.0.1
ARG RELEASE=1

LABEL name="zoa-runner" \
      vendor="Red Hat, Inc." \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="ZOA async Job runner and CLI" \
      description="Runs Trusted Actions in K8s Jobs with S3 artifact upload" \
      io.k8s.display-name="zoa-runner" \
      io.k8s.description="ZOA async Job runner and CLI" \
      com.redhat.component="zoa-runner-container" \
      distribution-scope="public" \
      url="https://github.com/openshift-online/rosa-hyperfleet-zoa"

WORKDIR /app

COPY --from=builder /app/zoa /usr/local/bin/zoa
COPY --from=builder /app/zoa-runner /usr/local/bin/zoa-runner

USER 65534:65534

ENTRYPOINT ["/usr/local/bin/zoa-runner"]
